  "definitions": {
    "raw": "(pick \"(ref animals)\" \"(ref birds)\" \"(ref fish)\" \"(ref bugs)\" \"(ref trees)\" \"(ref plants)\" \"(ref food)\" \"(ref objects)\" \"(ref tools)\" \"(ref parts)\" \"(ref materials)\" \"(ref fabrics)\" \"(ref terrain)\" \"(ref water)\" \"(ref weather)\" \"(ref buildings)\" \"(ref verbs)\" \"(ref fruit)\")",
    "vowel": "(mutate \"(ref raw)\" a \"(pick e i o u ae)\" e \"(pick a i o u ee)\" i \"(pick a e o u ia)\" o \"(pick a e i u ae)\" u \"(pick a e i o oo)\")",
    "chunk": "(mutate \"(ref raw)\" b bed c cr d dle f fl g glo k kl l lo m mb n no p pl r roo s sh t ty w wo)",
    "word": "(wpick 14 \"(ref raw)\" 3 \"(ref vowel)\" 2 \"(ref chunk)\")",
    "number": "(wpick 4 \"(nrange 1 9)\" 4 \"(nrange 10 99)\" 1 \"(nrange 100 999)\")"
  },
